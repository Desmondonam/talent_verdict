# ── Groq API (free at console.groq.com — no credit card needed) ──
GROQ_API_KEY=gsk_your-key-here

# ── Database ──────────────────────────────────────────────────
# Leave empty for local SQLite. Set to Supabase URI for production.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres

# ── Email (Gmail recommended — use an App Password, not your real password)
# To generate Gmail App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_NAME=Career Profile Analyzer
SERVICE_EMAIL=youremail@gmail.com

# ── Admin Panel ───────────────────────────────────────────────
# Change this to something long and random before deploying!
ADMIN_SECRET=changeme123
