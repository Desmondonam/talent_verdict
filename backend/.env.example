# ── Anthropic Claude API ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Email (Gmail recommended — use an App Password, not your real password)
# To generate Gmail App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_NAME=Career Profile Analyzer
SERVICE_EMAIL=youremail@gmail.com   # where reply CTAs point

# ── Admin Panel ───────────────────────────────────────────────
# Change this to something secret before deploying!
ADMIN_SECRET=changeme123
